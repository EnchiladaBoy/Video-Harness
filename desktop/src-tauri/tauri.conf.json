{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video Harness",
  "version": "0.7.2",
  "identifier": "io.github.EnchiladaBoy.VideoHarness",
  "build": {
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Video Harness",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": ["main"],
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; media-src 'self' asset: http://asset.localhost blob:; font-src 'self'; style-src 'self'; script-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "useLocalToolsDir": true,
    "publisher": "EnchiladaBoy",
    "homepage": "https://github.com/EnchiladaBoy/Video-Harness",
    "license": "MIT",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "Video",
    "shortDescription": "Create AI videos across providers",
    "longDescription": "A local-first desktop workspace for creating and safely tracking AI video generations across providers.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
